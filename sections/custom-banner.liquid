<section
  class="custom-banner"
  id="CustomBanner-{{ section.id }}"
>
  <div class="custom-banner__artwork">
    <img
  src="{{ 'gift-guide-artwork.png' | asset_url }}"
  alt=""
  loading="eager"
>
  </div>

  <div class="custom-banner__content">
    {% if section.settings.heading != blank %}
      <h1 class="custom-banner__heading">
        {{ section.settings.heading | escape }}
      </h1>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="custom-banner__description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <a
        class="custom-banner__button"
        href="{{ section.settings.button_link }}"
      >
        <span>{{ section.settings.button_text | escape }}</span>
        <span class="custom-banner__arrow">→</span>
      </a>
    {% endif %}
  </div>
</section>

<style>
  #CustomBanner-{{ section.id }} {
    position: relative;
    overflow: hidden;
    min-height: 700px;
    background: #f7f5f2;
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  #CustomBanner-{{ section.id }} .custom-banner__artwork {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  #CustomBanner-{{ section.id }} .custom-banner__artwork img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #CustomBanner-{{ section.id }} .custom-banner__content {
    position: relative;
    z-index: 2;
    width: 42%;
    max-width: 600px;
    padding: 80px 0 80px 7%;
    box-sizing: border-box;
  }

  #CustomBanner-{{ section.id }} .custom-banner__heading {
    margin: 0 0 24px;
    color: #000000;
    font-size: clamp(42px, 5vw, 72px);
    line-height: 1.05;
    font-weight: 500;
  }

  #CustomBanner-{{ section.id }} .custom-banner__description {
    max-width: 390px;
    margin-bottom: 32px;
    color: #000000;
    font-size: 16px;
    line-height: 1.5;
  }

  #CustomBanner-{{ section.id }} .custom-banner__button {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 14px 22px;
    background: #171331;
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition:
      transform 0.25s ease,
      background-color 0.25s ease,
      gap 0.25s ease;
  }

  #CustomBanner-{{ section.id }} .custom-banner__button:hover {
    transform: translateY(-3px);
    gap: 30px;
    background: #2b2550;
  }

  #CustomBanner-{{ section.id }} .custom-banner__arrow {
    font-size: 20px;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    #CustomBanner-{{ section.id }} {
      min-height: 620px;
      align-items: flex-end;
    }

    #CustomBanner-{{ section.id }} .custom-banner__artwork img {
      object-position: center top;
    }

    #CustomBanner-{{ section.id }} .custom-banner__content {
      width: 100%;
      max-width: none;
      padding: 320px 24px 45px;
      background: linear-gradient(
        to bottom,
        transparent 0%,
        rgba(247, 245, 242, 0.85) 35%,
        #f7f5f2 65%
      );
    }

    #CustomBanner-{{ section.id }} .custom-banner__heading {
      font-size: 42px;
    }

    #CustomBanner-{{ section.id }} .custom-banner__description {
      font-size: 14px;
      margin-bottom: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Banner heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Banner description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}