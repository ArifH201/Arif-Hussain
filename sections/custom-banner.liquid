<section
  class="custom-banner"
  id="CustomBanner-{{ section.id }}"
>
  <div class="custom-banner__artwork">
    <img
      src="{{ 'gift-guide-artwork_png.png' | asset_url }}"
      alt=""
      loading="eager"
    >
  </div>

  <div class="custom-banner__content">
    {% if section.settings.heading != blank %}
      <h1 class="custom-banner__heading">
        {{ section.settings.heading | escape }}
      </h1>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="custom-banner__description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <a
        class="custom-banner__button"
        href="{{ section.settings.button_link }}"
      >
        <span>{{ section.settings.button_text | escape }}</span>
        <span class="custom-banner__arrow">→</span>
      </a>
    {% endif %}
  </div>
</section>

<style>
  #CustomBanner-{{ section.id }} {
    position: relative;
    overflow: hidden;
    min-height: 700px;
    background: #ffffff;
    box-sizing: border-box;
  }

  /* Figma artwork */
  #CustomBanner-{{ section.id }} .custom-banner__artwork {
    position: absolute;
    top: 0;
    right: 0;
    width: 72%;
    height: 100%;
    z-index: 1;
  }

  #CustomBanner-{{ section.id }} .custom-banner__artwork img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Text positioned down and left into the white space */
  #CustomBanner-{{ section.id }} .custom-banner__content {
    position: absolute;
    left: 7%;
    top: 62%;
    transform: translateY(-50%);
    z-index: 2;
    width: 40%;
    max-width: 520px;
    box-sizing: border-box;
  }

  #CustomBanner-{{ section.id }} .custom-banner__heading {
    margin: 0 0 10px;
    color: #171331;
    font-size: clamp(42px, 5vw, 72px);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -1px;
  }

  #CustomBanner-{{ section.id }} .custom-banner__description {
    max-width: 390px;
    margin: 0 0 5px;
    color: #555555;
    font-size: 16px;
    line-height: 1.5;
  }

  #CustomBanner-{{ section.id }} .custom-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    min-width: 145px;
    padding: 14px 20px;
    background: #171331;
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    box-sizing: border-box;

    transition:
      transform 0.25s ease,
      background-color 0.25s ease,
      gap 0.25s ease;
  }

  /* Button animation required by the test */
  #CustomBanner-{{ section.id }} .custom-banner__button:hover {
    transform: translateY(-3px);
    gap: 30px;
    background: #2b2550;
  }

  #CustomBanner-{{ section.id }} .custom-banner__arrow {
    font-size: 20px;
    line-height: 1;
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    #CustomBanner-{{ section.id }} {
      min-height: 680px;
    }

    #CustomBanner-{{ section.id }} .custom-banner__artwork {
      width: 100%;
      height: 100%;
      right: 0;
    }

    #CustomBanner-{{ section.id }} .custom-banner__artwork img {
      object-fit: cover;
      object-position: center top;
    }

    #CustomBanner-{{ section.id }} .custom-banner__content {
      left: 24px;
      right: 24px;
      top: auto;
      bottom: 45px;
      transform: none;
      width: auto;
      max-width: none;
      padding: 0;
    }

    #CustomBanner-{{ section.id }} .custom-banner__heading {
      font-size: 42px;
      margin-bottom: 10px;
    }

    #CustomBanner-{{ section.id }} .custom-banner__description {
      max-width: 360px;
      font-size: 14px;
      margin-bottom: 5px;
    }

    #CustomBanner-{{ section.id }} .custom-banner__button {
      padding: 13px 18px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Banner heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Banner description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}